<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened runtime exceptions required by Electron itself:
      - JIT: V8 generates code at runtime.
      - unsigned-executable-memory: V8 also writes-then-executes pages.
    Deliberately absent:
      - allow-dyld-environment-variables: with it, DYLD_INSERT_LIBRARIES could
        load any dylib into the signed app with its TCC grants. Electron 29
        doesn't need DYLD_* variables.
      - disable-library-validation: electron-builder signs every Mach-O in the
        bundle (whisper-cli and its .dylibs, the onnxruntime/keytar .node
        addons, the Swift helpers) with our team ID, and notarization only
        accepts the build if it did, so library validation passes. If a signed
        build ever fails to load one of them, add this key back only in a
        separate entitlementsInherit plist for that helper, never for the app.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- whisper.cpp STT: microphone capture -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Screen capture (desktopCapturer) for OCR / screen context -->
  <!-- macOS prompts the user via System Settings → Privacy → Screen Recording -->

  <!-- AppleScript / osascript control of other apps (Mail, Outlook for Mac,
       System Events for window enumeration) -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
